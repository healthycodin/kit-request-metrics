{
	"name": "@healthycodin/kit-request-metrics",
	"version": "0.2.1",
	"description": "Request metrics tracking for SvelteKit with MongoDB storage",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/healthycodin/kit-request-metrics.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0 || ^3.0.0",
		"mongodb": "^7.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/coverage-v8": "^5.0.3",
		"mongodb": "^7.0.0",
		"mongodb-memory-server": "^10.0.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"keywords": [
		"sveltekit",
		"metrics",
		"mongodb",
		"analytics",
		"performance",
		"hook"
	],
	"engines": {
		"node": ">=20"
	}
}
